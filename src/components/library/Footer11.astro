---
/**
 * Footer11 — Relume footer family footers/f11 (footers-7).
 * Logo with inline links, then a ruled credits row.
 */
import CompanyLogo from "./CompanyLogo.astro";

interface Props {
  links?: string[];
  copyright?: string;
  legalLinks?: string[];
}

const {
  links = ["Link One", "Link Two", "Link Three", "Link Four", "Link Five"],
  copyright = "© 2024 Relume. All rights reserved.",
  legalLinks = ["Privacy Policy", "Terms of Service", "Cookies Settings"],
} = Astro.props;
---
<footer class="footer-11">
  <div class="footer-11__container">
    <div class="footer-11__brand">
      <CompanyLogo />
      <ul class="footer-11__inline-links">
        {links.map((label) => (
          <li><a class="footer-11__link footer-11__inline-link" href="#">{label}</a></li>
        ))}
      </ul>
    </div>
    <div class="footer-11__credits">
      <hr class="footer-11__divider" />
      <div class="footer-11__bottom">
        <p class="footer-11__copyright">{copyright}</p>
        <ul class="footer-11__legal">
          {legalLinks.map((label) => (
            <li><a class="footer-11__link footer-11__legal-link" href="#">{label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-11 {
    padding: var(--space-72) var(--space-section-horizontal-l);
    background: var(--bg-main);
    color: var(--text-main);
  }
  .footer-11__container {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
    width: 100%;
    max-width: var(--size-container-l);
    margin-inline: auto;
  }
  .footer-11 ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-11 p {
    margin: 0;
  }
  .footer-11__link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease, opacity 0.15s ease;
  }
  .footer-11__link:hover {
    color: var(--text-secondary);
  }
  .footer-11__link:active {
    opacity: 0.7;
  }
  .footer-11__link:focus-visible {
    outline: 1px solid var(--line-accent);
    outline-offset: var(--space-4);
  }
  .footer-11__link[aria-disabled="true"] {
    opacity: 0.5;
    pointer-events: none;
  }
  .footer-11__inline-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }
  .footer-11__inline-link {
    font-size: var(--font-body-m-size);
    line-height: var(--font-body-m-line-height);
    font-weight: 600;
  }
  .footer-11__credits {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  .footer-11__divider {
    width: 100%;
    margin: 0;
    border: 0;
    border-top: 1px solid var(--line-tertiary);
  }
  .footer-11__bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-32);
    padding-bottom: var(--space-16);
    font-size: var(--font-body-m-size);
    line-height: var(--font-body-m-line-height);
  }
  .footer-11__legal {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    order: -1;
  }
  .footer-11__legal-link {
    font-size: var(--font-body-m-size);
    line-height: var(--font-body-m-line-height);
  }
  .footer-11__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-24);
    min-width: 0;
  }
  .footer-11__brand {
    gap: var(--space-32);
    max-width: var(--size-measure-s);
  }
  .footer-11__inline-links {
    gap: var(--space-24);
  }

  @media (min-width: 768px) {
    .footer-11__container {
      gap: var(--space-72);
    }
    .footer-11__inline-links {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-32);
    }
    .footer-11__credits {
      gap: var(--space-32);
    }
    .footer-11__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-24);
      padding-bottom: var(--space-0);
    }
    .footer-11__legal {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-24);
      order: 0;
    }
  }
</style>
