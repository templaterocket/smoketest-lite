---
/**
 * Hero header 82 — heading, text and buttons, then a full-bleed 16:9 image.
 */
import Button from "./Button.astro";

interface Props {
  /** Hero heading (h1). */
  heading?: string;
  /** Supporting paragraph. */
  description?: string;
  /** Primary action label. */
  primaryLabel?: string;
  /** Secondary action label. */
  secondaryLabel?: string;
  /** Accessible name of the image placeholder(s). */
  imageAlt?: string;
}

const {
  heading = "Medium length hero heading goes here",
  description = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare, eros dolor interdum nulla, ut commodo diam libero vitae erat.",
  primaryLabel = "Button",
  secondaryLabel = "Button",
  imageAlt = "Placeholder image",
} = Astro.props;
---
<section class="hero-header-82">
  <div class="hero-header-82__body">
    <div class="hero-header-82__container">
      <div class="hero-header-82__column">
        <div class="hero-header-82__content">
          <h1 class="hero-header-82__heading">{heading}</h1>
          <p class="hero-header-82__description">{description}</p>
        </div>
        <div class="hero-header-82__actions">
          <Button label={primaryLabel} href="#" variant="primary" />
          <Button label={secondaryLabel} href="#" variant="secondary" />
        </div>
      </div>
    </div>
  </div>
  <div class="hero-header-82__image" role="img" aria-label={imageAlt}></div>
</section>

<style>
  .hero-header-82 {
    background: var(--bg-main);
    color: var(--text-main);
  }
  .hero-header-82__body {
    padding: var(--space-section-vertical-l) var(--space-section-horizontal-l);
  }
  .hero-header-82__container {
    width: 100%;
    max-width: var(--size-container-l);
    margin-inline: auto;
  }
  .hero-header-82__column {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    max-width: var(--size-measure-l);
  }
  .hero-header-82__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }
  .hero-header-82__heading {
    margin: var(--space-0);
    color: var(--text-main);
    font-size: var(--font-titles-h1-size);
    line-height: var(--font-titles-h1-line-height);
    font-weight: 700;
  }
  .hero-header-82__description {
    margin: var(--space-0);
    color: var(--text-main);
    font-size: var(--font-body-l-size);
    line-height: var(--font-body-l-line-height);
  }
  .hero-header-82__actions {
    display: flex;
    flex-wrap: wrap;
    align-self: flex-start;
    width: fit-content;
    max-width: 100%;
    gap: var(--space-16);
  }
  .hero-header-82__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--bg-tertiary);
  }

  @media (min-width: 768px) {
    .hero-header-82__column {
      gap: var(--space-32);
    }
    .hero-header-82__content {
      gap: var(--space-24);
    }
    .hero-header-82__description {
      font-size: var(--font-body-xl-size);
      line-height: var(--font-body-xl-line-height);
    }
  }
</style>
