// Cloudflare Workers static assets for Smoketest Lite: the built site (dist/), no Worker code —
// the form posts from the visitor's browser to your form service. Deploy with `npm run build` and
// `npx wrangler deploy`, or connect the repository in the Cloudflare dashboard (build command
// `npm run build`, deploy command `npx wrangler deploy`). dist/_redirects (from public/) is applied,
// and a page address without its slash (/legal/privacy) redirects to the page (/legal/privacy/).
{
  "name": "smoketest-lite",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  }
}
